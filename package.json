{
  "name": "bug-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bug tracker for testers and developers: React + Node.js + SQLite",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "import": "node server/import-cli.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
